# Copy to a private systemd EnvironmentFile outside the checkout.
OVIS_AUTH=oidc
APP_BASE_URL=https://dev-ovis.datbt.dev
OIDC_ISSUER_URL=https://id.datbt.dev
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://dev-ovis.datbt.dev/auth/oidc/callback
# Only for a trusted Pocket ID origin on this same host.
# OIDC_LOOPBACK_URL=http://127.0.0.1:80
# Generate with openssl rand -hex 32.
SESSION_SECRET=
HOST=127.0.0.1
PORT=7318
# Keep this absolute path short enough for Linux Unix sockets.
OVIS_STATE_DIR=/var/lib/ovis-dev
OVIS_HERDR_BIN=/usr/local/bin/herdr
# OVIS_PTY_SIDECAR_BIN=/opt/ovis-dev/current/bin/ovis-pty-sidecar
